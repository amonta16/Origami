# Copy to .env.local and fill in. Never commit .env.local.
# Values also live in the Vercel project settings (pasted there by hand, never printed).

# Supabase (new project created for Facet; never the Atlas project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_EMAILS=

# AI providers (Phase 1). Only the keys you have; the lab shows which are configured.
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
FAL_KEY=

# Analysis provider: openai | gemini. Default: OpenAI if its key exists, else Gemini.
# Gemini text models are on Google's free tier; image models are not.
# ANALYSIS_PROVIDER=

# Optional model overrides (defaults verified against provider docs on Nov 14, 2026;
# Gemini default chosen by latency on the live deploy, see src/lib/analysis/gemini.ts)
# OPENAI_VISION_MODEL=gpt-6.1-terra
# GEMINI_VISION_MODEL=gemini-3-flash-preview
# GEMINI_THINKING_LEVEL=low   # low (default, ~6 s per scan) | high | off
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_IMAGE_QUALITY=medium
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# FAL_EDIT_MODEL=fal-ai/flux-pro/kontext
# FAL_FILL_MODEL=fal-ai/flux-pro/v1/fill
# Which provider the patient flow uses by default (gemini | fal | openai). Set after the bake-off.
# SIM_PRIMARY_PROVIDER=
